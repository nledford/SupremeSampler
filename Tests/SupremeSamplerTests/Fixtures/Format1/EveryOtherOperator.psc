{
  Random Catalog Sample
  =====================

  Returns a fresh random sample of catalog items in a new Photo Supreme tab.

  Pending deletion: only
  Rating filter: at most 2
  Rating filter: exactly 4
  Keyword count filter: is at least 2
  Keyword count filter: is not 3
  Keyword count filter: is 1
  Path filter: starts with "/Volumes/Test/"
  Path filter: does not contain "draft"
  Path filter: does not start with "/tmp/"
  Path filter: ends with ".jpg"
  Keyword path filter: contains "tree"
  Keyword path filter: does not contain "tree"
  Keyword path filter: ends with "\Oak"
  Keyword path filter: does not end with "\Oak"
  Keyword path filter: has no part named "Oak"
  Keyword path filter: starts with "Nature"
  Keyword path filter: contains ""
  Label filter: none of 1 label
  Label filter: any of 0 labels
  File type filter: any of png, webp
  Bookmark filter: any of Curated, Random uncurated
  Category filter: all of 2 categories (including subcategories)
  Match any of:
  Match none of:
    Rating filter: at least 5

  Script format: 1
  Generated by Supreme Sampler on 2026-09-27T12:00:00Z.
}

const
  SAMPLE_SIZE = 400;

// Extra margin above the expected hit count when oversampling random
// rowids. Benchmarked safe at 2.4x oversample against the real catalog.
const
  ROWID_OVERSAMPLE_MARGIN = 1.15;

// Safety cap on retry passes, in case a shortfall never closes.
const
  ROWID_MAX_SAMPLE_ATTEMPTS = 8;

// Hard ceiling on random rowids drawn per pass, in case catalog
// density ever drops low enough to make a batch huge.
const
  ROWID_MAX_BATCH_SIZE = 100000;

function RandomItemGUIDs(ACount: Integer): TStringList;
var
  AExtentSet: TDBXOMClientDataSet;
  ASampleSet: TDBXOMClientDataSet;
  ACandidates: TStringList;
  ATotalRows, AMaxRowID: Integer;
  ADensity: Double;
  ABatchSize, AAttempt, AShortfall, I: Integer;
begin
  Randomize;
  result := TStringList.Create;
  result.Sorted := True;
  result.Duplicates := dupIgnore;

  AExtentSet := PublicCatalog.NewDataSet;
  try
    AExtentSet.CommandText :=
      'SELECT COUNT(*) AS RowCount, MAX(rowid) AS MaxRowID FROM idCatalogItem WHERE COALESCE(Rating, 0) < 0 AND Rating <= 2 AND Rating = 4 AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp) GROUP BY d.CatalogItemGUID HAVING COUNT(DISTINCT d.GUID) >= 2) AND idCatalogItem.GUID NOT IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp) GROUP BY d.CatalogItemGUID HAVING NOT (COUNT(DISTINCT d.GUID) <> 3)) AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp) GROUP BY d.CatalogItemGUID HAVING COUNT(DISTINCT d.GUID) = 1) AND EXISTS (SELECT 1 FROM idCache_FilePath fp WHERE fp.FilePathGUID = idCatalogItem.PathGUID AND (fp.FilePath || idCatalogItem.FileName) LIKE ''/Volumes/Test/%'' ESCAPE ''\'') AND NOT EXISTS (SELECT 1 FROM idCache_FilePath fp WHERE fp.FilePathGUID = idCatalogItem.PathGUID AND (fp.FilePath || idCatalogItem.FileName) LIKE ''%draft%'' ESCAPE ''\'') AND NOT EXISTS (SELECT 1 FROM idCache_FilePath fp WHERE fp.FilePathGUID = idCatalogItem.PathGUID AND (fp.FilePath || idCatalogItem.FileName) LIKE ''/tmp/%'' ESCAPE ''\'') AND EXISTS (SELECT 1 FROM idCache_FilePath fp WHERE fp.FilePathGUID = idCatalogItem.PathGUID AND (fp.FilePath || idCatalogItem.FileName) LIKE ''%.jpg'' ESCAPE ''\'') AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''%tree%'' ESCAPE ''\'')) AND idCatalogItem.GUID NOT IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''%tree%'' ESCAPE ''\'')) AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''%\\Oak'' ESCAPE ''\'')) AND idCatalogItem.GUID NOT IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''%\\Oak'' ESCAPE ''\'')) AND idCatalogItem.GUID NOT IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE ''\'' || kp.path || ''\'' LIKE ''%\\Oak\\%'' ESCAPE ''\'')) AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''Nature%'' ESCAPE ''\'')) AND 1 = 1 AND COALESCE(idLabel, '''') NOT IN (''Red'') AND 0 = 1 AND (COALESCE(FileName, '''') LIKE ''%.png'' ESCAPE ''\'' OR COALESCE(FileName, '''') LIKE ''%.webp'' ESCAPE ''\'') AND CAST(COALESCE(idBookmark, 0) AS INTEGER) IN (2, 3) AND (idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.GUID IN (''KW-OAKS'', ''KW-RED-OAKS'') AND d.CatalogItemGUID IS NOT NULL) AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.GUID IN (''KW-PINES'') AND d.CatalogItemGUID IS NOT NULL)) AND 0 = 1 AND NOT COALESCE((Rating >= 5), 0)';
    AExtentSet.OpenSet;
    ATotalRows := AExtentSet.FieldValue('RowCount');
    AMaxRowID := AExtentSet.FieldValue('MaxRowID');
    AExtentSet.CloseSet;
  finally
    PublicCatalog.FreeDataSet(AExtentSet);
  end;

  if (ATotalRows > 0) and (AMaxRowID > 0) then
  begin
    if ACount > ATotalRows then
      ACount := ATotalRows;

    ADensity := ATotalRows / AMaxRowID;

    AAttempt := 0;
    while (result.Count < ACount) and (AAttempt < ROWID_MAX_SAMPLE_ATTEMPTS) do
    begin
      Inc(AAttempt);
      AShortfall := ACount - result.Count;
      ABatchSize := Trunc(AShortfall / ADensity * ROWID_OVERSAMPLE_MARGIN) + 1;
      if ABatchSize > ROWID_MAX_BATCH_SIZE then
        ABatchSize := ROWID_MAX_BATCH_SIZE;

      ACandidates := TStringList.Create;
      try
        for I := 1 to ABatchSize do
          ACandidates.Add(IntToStr(Trunc(Random * AMaxRowID) + 1));

        ASampleSet := PublicCatalog.NewDataSet;
        try
          ASampleSet.CommandText :=
            'SELECT GUID FROM idCatalogItem WHERE rowid IN (' +
            ACandidates.CommaText + ') AND COALESCE(Rating, 0) < 0 AND Rating <= 2 AND Rating = 4 AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp) GROUP BY d.CatalogItemGUID HAVING COUNT(DISTINCT d.GUID) >= 2) AND idCatalogItem.GUID NOT IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp) GROUP BY d.CatalogItemGUID HAVING NOT (COUNT(DISTINCT d.GUID) <> 3)) AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp) GROUP BY d.CatalogItemGUID HAVING COUNT(DISTINCT d.GUID) = 1) AND EXISTS (SELECT 1 FROM idCache_FilePath fp WHERE fp.FilePathGUID = idCatalogItem.PathGUID AND (fp.FilePath || idCatalogItem.FileName) LIKE ''/Volumes/Test/%'' ESCAPE ''\'') AND NOT EXISTS (SELECT 1 FROM idCache_FilePath fp WHERE fp.FilePathGUID = idCatalogItem.PathGUID AND (fp.FilePath || idCatalogItem.FileName) LIKE ''%draft%'' ESCAPE ''\'') AND NOT EXISTS (SELECT 1 FROM idCache_FilePath fp WHERE fp.FilePathGUID = idCatalogItem.PathGUID AND (fp.FilePath || idCatalogItem.FileName) LIKE ''/tmp/%'' ESCAPE ''\'') AND EXISTS (SELECT 1 FROM idCache_FilePath fp WHERE fp.FilePathGUID = idCatalogItem.PathGUID AND (fp.FilePath || idCatalogItem.FileName) LIKE ''%.jpg'' ESCAPE ''\'') AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''%tree%'' ESCAPE ''\'')) AND idCatalogItem.GUID NOT IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''%tree%'' ESCAPE ''\'')) AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''%\\Oak'' ESCAPE ''\'')) AND idCatalogItem.GUID NOT IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''%\\Oak'' ESCAPE ''\'')) AND idCatalogItem.GUID NOT IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE ''\'' || kp.path || ''\'' LIKE ''%\\Oak\\%'' ESCAPE ''\'')) AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.CatalogItemGUID IS NOT NULL AND d.GUID IN (WITH RECURSIVE kp(guid, path, depth) AS (SELECT GUID, CategoryName, 0 FROM idPropCategory WHERE substr(GUID, 1, 1) <> char(123) UNION ALL SELECT p.GUID, kp.path || ''\'' || p.PropName, kp.depth + 1 FROM idProp p JOIN kp ON p.ParentGUID = kp.guid WHERE kp.depth < 32) SELECT kp.guid FROM kp WHERE kp.path LIKE ''Nature%'' ESCAPE ''\'')) AND 1 = 1 AND COALESCE(idLabel, '''') NOT IN (''Red'') AND 0 = 1 AND (COALESCE(FileName, '''') LIKE ''%.png'' ESCAPE ''\'' OR COALESCE(FileName, '''') LIKE ''%.webp'' ESCAPE ''\'') AND CAST(COALESCE(idBookmark, 0) AS INTEGER) IN (2, 3) AND (idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.GUID IN (''KW-OAKS'', ''KW-RED-OAKS'') AND d.CatalogItemGUID IS NOT NULL) AND idCatalogItem.GUID IN (SELECT d.CatalogItemGUID FROM idCatalogItemDefinition d WHERE d.GUID IN (''KW-PINES'') AND d.CatalogItemGUID IS NOT NULL)) AND 0 = 1 AND NOT COALESCE((Rating >= 5), 0)';
          ASampleSet.OpenSet;
          while (not ASampleSet.EndOfSet) and (result.Count < ACount) do
          begin
            result.Add(ASampleSet.FieldValue('GUID'));
            ASampleSet.NextInSet;
          end;
          ASampleSet.CloseSet;
        finally
          PublicCatalog.FreeDataSet(ASampleSet);
        end;
      finally
        ACandidates.Free;
      end;
    end;
  end;
end;


// Materializes the random GUIDs into full catalog items (with datasets).
function BuildRandomItems: TCatalogItems;
var
  AGUIDs: TStringList;
  AClassGUID: String;
begin
  result := TCatalogItems.Create(TCatalogItem, '');

  AGUIDs := RandomItemGUIDs(SAMPLE_SIZE);
  try
    AClassGUID := PublicCatalog.StoreItemGUIDsToTempList(AGUIDs, False);
    try
      PublicCatalog.EnumItemsFromTempListGUID(AClassGUID, result);
    finally
      PublicCatalog.RemoveItemsFromTempListForClassGUID(AClassGUID);
    end;
  finally
    AGUIDs.Free;
  end;
end;


procedure OpenNewTabForDataset(ADatasets: TDBXOMDataSets);
var
  AData: TidElement;
  AColl: Variant;
begin
  AData := TidElement.Create(nil);
  try
    PublicBroadCast(nil, 'OpenNewTab', nil);
    PublicBroadCastRequest(nil, 'ActiveCollection', AData);
    AColl := AData.Data;
    AColl.Clear;
    AColl.Items._DataSets := ADatasets;
    PublicBroadCast(nil, 'RefreshActiveCollection', nil);
  finally
    AData.Free;
  end;
end;


procedure OpenRandomSample;
var
  AItems: TCatalogItems;
  ADatasets: TDBXOMDataSets;
begin
  AItems := BuildRandomItems;
  try
    ADatasets := AItems.DataSets;
    AItems._DataSets := TDBXOMDataSets.Create(TDBXOMDataSet, '');
  finally
    AItems.Free;
  end;

  OpenNewTabForDataset(ADatasets);
end;


begin
  OpenRandomSample;
end;
